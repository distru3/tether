{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Tether",
  "version": "0.2.0-beta",
  "identifier": "app.screentime.dev",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Tether",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 480,
        "resizable": true,
        "fullscreen": false,
        "decorations": false,
        "theme": "Dark",
        "shadow": true,
        "visible": false
      },
      {
        "label": "overlay",
        "title": "Tether Overlay",
        "url": "index.html?view=overlay",
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": false,
        "resizable": false,
        "shadow": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Utility",
    "shortDescription": "Screen time tracking and limits",
    "longDescription": "Track application usage, set daily limits per app or category, and block distracting websites.",
    "windows": {
      "nsis": {
        "installMode": "perMachine",
        "installerHooks": "installer_hooks.nsh"
      }
    },
    "resources": [
      "bin/screentime-agent.exe",
      "bin/screentime-session.exe"
    ]
  }
}