{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Tether",
  "version": "0.1.0",
  "identifier": "app.screentime.dev",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Tether",
        "width": 1150,
        "height": 720,
        "minWidth": 960,
        "minHeight": 480,
        "resizable": true,
        "fullscreen": false,
        "decorations": false,
        "theme": "Dark",
        "shadow": true,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "category": "Utility",
    "shortDescription": "Screen time tracking and limits",
    "longDescription": "Track application usage, set daily limits per app or category, and block distracting websites.",
    "windows": {
      "nsis": {
        "installMode": "perMachine",
        "installerHooks": "installer_hooks.nsh"
      }
    },
    "resources": [
      "bin/screentime-agent.exe",
      "bin/screentime-session.exe"
    ]
  }
}