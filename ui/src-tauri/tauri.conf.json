{
    "$schema": "https://schema.tauri.app/config/2",
    "productName": "Screentime",
    "version": "0.1.0",
    "identifier": "app.screentime.dev",
    "build": {
        "beforeDevCommand": "npm run dev",
        "beforeBuildCommand": "npm run build",
        "devUrl": "http://localhost:1420",
        "frontendDist": "../dist"
    },
    "app": {
        "windows": [
            {
                "title": "Screentime",
                "width": 960,
                "height": 640,
                "minWidth": 720,
                "minHeight": 480,
                "resizable": true,
                "fullscreen": false,
                "decorations": false,
                "shadow": true
            }
        ],
        "security": {
            "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'"
        }
    },
    "bundle": {
        "active": true,
        "targets": [
            "nsis"
        ],
        "icon": [
            "icons/icon.png"
        ],
        "category": "Utility",
        "shortDescription": "Screen time tracking and limits",
        "longDescription": "Track application usage, set daily limits per app or category, and block distracting websites."
    }
}
